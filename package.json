{
  "name": "prompt-optimizer",
  "version": "1.3.0",
  "description": "DSH 一键提示词优化插件，支持本地规则零成本优化与角色化 LLM 深度优化",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack:zip": "node scripts/pack.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-optimizer"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-slots": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-composer": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-settings": ">=0.2.0-rc.2 <0.3.0",
    "cordis": "*",
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
